@echo off
chcp 65001 > nul
cls

echo ==========================================
echo        카오스 슈퍼오목 자동 푸시 시작
echo ==========================================
echo.

:: 1. 변경된 파일 전체 스테이징
echo [+] 파일 추적 중 (git add)...
git add -A

:: 2. 커밋 메시지 입력 (입력 없이 엔터 치면 현재 날짜/시간으로 자동 커밋)
set /p msg="커밋 메시지 입력 (엔터 치면 자동생성): "
if "%msg%"=="" (
    set msg=update: %date% %time%
)

:: 3. 커밋 생성
echo [+] 커밋 생성 중...
git commit -m "%msg%"

:: 4. 깃허브 푸시
echo.
echo [+] 깃허브 메인 브랜치로 전송 중 (git push)...
git push origin main

echo.
if %errorlevel% equ 0 (
    echo ==========================================
    echo [성공] 깃허브 업로드 완료! Render 배포 시작됨.
    echo ==========================================
) else (
    echo ==========================================
    echo [실패] 푸시 중 문제가 발생했습니다.
    echo ==========================================
)

echo.
pause